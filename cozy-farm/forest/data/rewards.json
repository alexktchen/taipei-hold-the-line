  "stories": [
    {"neighbor": "阿跳", "after": "shengmu", "text": "我發現「跑」和「跳」的聲母不一樣！ㄆ和ㄊ，念起來嘴巴的動作差好多。下次我們一起邊跑邊念注音吧！"},
    {"neighbor": "小禾", "after": "yunmu", "text": "菜園裡的「瓜」念ㄍㄨㄚ，裡面藏著ㄨ和ㄚ兩個韻母喔！我在每棵菜旁邊都插了注音牌子。"},
    {"neighbor": "咪嚕", "after": "shengdiao", "text": "呼啊⋯⋯我睡前會練習聲調：媽、麻、馬、罵⋯⋯每次念到第三聲就睡著了。"},
    {"neighbor": "書書", "after": "renzi", "text": "你知道嗎？「山」這個字，很久以前畫得就像三座山峰。我在書塔找到一本象形字圖鑑！"},
    {"neighbor": "阿壯", "after": "bihua", "text": "寫字和運動一樣要照順序！先橫後豎、先撇後捺，就像暖身要先拉筋再跑步。"},
    {"neighbor": "阿跳", "after": "guard-zhuyin", "text": "聽說你打敗了注音守護者！村子裡的大家都說你是注音小達人！"},
    {"neighbor": "書書", "after": "bushou", "text": "我把書架照部首排好了：言部的書最多，「說、話、語、讀」都住在一起。"},
    {"neighbor": "小禾", "after": "xingsheng", "text": "「晴、清、請、情」都有一個「青」，就像同一種種子，長出不同的花。"},
    {"neighbor": "阿跳", "after": "lianjie", "text": "因為我每天練跑，所以跑得越來越快！你看，我也會用連接詞了。"},
    {"neighbor": "咪嚕", "after": "piyu", "text": "我的被窩像一朵軟綿綿的雲⋯⋯欸，這是不是就是譬喻？"},
    {"neighbor": "阿壯", "after": "kuashi", "text": "教練說我的力氣大得可以舉起一座山——我知道，這是誇飾啦！"},
    {"neighbor": "小禾", "after": "guard-xiuci", "text": "修辭花園的花都開了！你種的花被好多蝴蝶圍住，好漂亮。"},
    {"neighbor": "書書", "after": "cy-diangu", "text": "我最喜歡「守株待兔」的故事。不過我不會等兔子，我會每天讀一點書。"},
    {"neighbor": "咪嚕", "after": "zhuzhi", "text": "我讀完一篇文章都會問自己：作者最想告訴我什麼？這樣就不會讀著讀著睡著了⋯⋯大概吧。"}
  ],
